        "type": "APF_SCIENCE",
        "formats": [
          "fits",
          "xisf",
          "image",
          "raw",
          "video"
        ],
        "cardinality": "many",
        "required": true,
        "supports_hdu": false,
        "supports_slice": false,
        "multiple_connections": false,
        "data_kind": "sequence",
        "colour_layout": "planar"
      },
