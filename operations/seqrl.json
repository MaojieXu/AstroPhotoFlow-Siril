{
  "operation": {
    "package_id": "siril",
    "version": "1.4.4",
    "operation_id": "seqrl",
    "name": "seqrl",
    "description": "The same as the RL command, but applies to a sequence which must be specified as the first argument\n\nLinks: rl\n\nUses fixed input references and writes only invocation-owned outputs. Optional argument values are sent only when their use_* control is true; zero is preserved.",
    "syntax": "seqrl sequencename [-loadpsf=] [-alpha=] [-iters=] [-stop=] [-gdstep=] [-tv] [-fh] [-mul]",
    "scriptable": true,
    "inputs": [
      {
