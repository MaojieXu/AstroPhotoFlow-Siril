{
  "operation": {
    "package_id": "siril",
    "version": "1.4.4",
    "operation_id": "stackall",
    "name": "stackall",
    "description": "Opens all sequences in the current directory and stacks them with the optionally specified stacking type and filtering or with sum stacking. See STACK command for options description\n\nLinks: stack\n\nUses fixed input references and writes only invocation-owned outputs. Optional argument values are sent only when their use_* control is true; zero is preserved.",
    "syntax": "stackall\nstackall { sum | min | max } [-maximize] [-upscale] [-32b]\nstackall { med | median } [-nonorm, norm=] [-32b]\nstackall { rej | mean } [rejection type] [sigma_low sigma_high] [-nonorm, norm=] [-overlap_norm] [-weight={noise|wfwhm|nbstars|nbstack}] [-feather=] [-rgb_equal] [-out=filename] [-maximize] [-upscale] [-32b]",
    "scriptable": true,
    "inputs": [
      {
        "name": "sequences",
        "type": "APF_SCIENCE",
        "formats": [
          "fits",
          "xisf",
          "image",
          "raw",
          "video"
        ],
        "cardinality": "many",
        "required": true,
        "supports_hdu": false,
        "supports_slice": false,
        "multiple_connections": true,
        "data_kind": "sequence",
        "colour_layout": "planar"
      }
    ],
    "outputs": [
      {
        "name": "image",
        "type": "APF_SCIENCE",
        "formats": [
          "fits"
        ],
        "cardinality": "many",
        "required": true,
        "colour_layout": "planar"
      },
      {
        "name": "rejection_maps",
        "type": "APF_SCIENCE",
        "formats": [
          "fits"
        ],
        "cardinality": "many",
        "required": false,
        "colour_layout": "planar"
      }
    ],
    "parameters": [
