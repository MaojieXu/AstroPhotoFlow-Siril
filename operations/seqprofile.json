{
  "operation": {
    "package_id": "siril",
    "version": "1.4.4",
    "operation_id": "seqprofile",
    "name": "seqprofile",
    "description": "Generates an intensity profile plot between 2 points in each image in the sequence. After the mandatory first argument stating the sequence to process, the other arguments are the same as for the profile command. If processing a sequence and it is desired to have the current image number and total number of images displayed in the format \"My Sequence (1 / 5)\", the given title should end with () (e.g. \"My Sequence ()\" and the numbers will be populated automatically)\n\nUses fixed input references and writes only invocation-owned outputs. Optional argument values are sent only when their use_* control is true; zero is preserved.",
    "syntax": "seqprofile sequence -from=x,y -to=x,y [-tri] [-cfa] [-arcsec] [-savedat] [-layer=] [-width=] [-spacing=] [ {-xaxis=wavelength | -xaxis=wavenumber } ] [{-wavenumber1= | -wavelength1=} -wn1at=x,y {-wavenumber2= | -wavelength2=} -wn2at=x,y] [\"-title=My Plot\"]",
    "scriptable": true,
    "inputs": [
      {
        "name": "image",
        "type": "APF_SCIENCE",
        "formats": [
          "fits",
          "xisf",
          "image",
          "raw",
          "video"
        ],
        "cardinality": "many",
        "required": true,
        "supports_hdu": false,
        "supports_slice": false,
        "multiple_connections": false,
        "data_kind": "sequence",
        "colour_layout": "planar"
      }
    ],
    "outputs": [
      {
        "name": "image",
        "type": "APF_SCIENCE",
        "formats": [
          "fits",
          "video"
        ],
        "cardinality": "many",
        "required": true,
        "colour_layout": "planar"
      },
      {
        "name": "analysis",
        "type": "APF_ANALYSIS",
        "formats": [
          "other"
        ],
        "cardinality": "many",
        "required": true
      },
      {
        "name": "files",
        "type": "APF_FILE",
        "formats": [
          "other",
          "image"
        ],
        "cardinality": "many",
        "required": false
      }
    ],
    "parameters": [
