{
  "definition_id": "4ed4a438-8d35-5c85-b5d9-4b08760a8412",
  "source": "package",
  "name": "Sequence Background Extraction (seqsubsky)",
  "category": [
    "background-filters",
    "background-extraction"
  ],
  "description": "Same command as SUBSKY but for the sequence sequencename .\n\nDithering, required for low dynamic gradients, can be disabled with -nodither . Note that the -existing option is not available for sequence background removal, as the frames of a sequence are not necessarily always aligned.\n\nThe output sequence name starts with the prefix \"bkg_\" unless otherwise specified with -prefix= option. Only selected images in the sequence are processed\n\nLinks: subsky\n\nUses fixed input references and writes only invocation-owned outputs. Optional argument values are sent only when their use_* control is true; zero is preserved.",
  "inputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "outputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "parameters": [
    {
      "name": "model",
      "kind": "choice",
      "default": "polynomial",
      "advanced": false,
      "nullable": false,
      "choices": [
        "polynomial",
        "rbf"
      ]
    },
    {
      "name": "degree",
      "kind": "int",
      "default": 1,
      "advanced": false,
      "nullable": false,
      "minimum": 1,
      "maximum": 4
    },
    {
      "name": "no_dither",
      "kind": "boolean",
      "default": false,
      "advanced": false,
      "nullable": false
    },
    {
      "name": "samples",
      "kind": "int",
      "default": 20,
      "advanced": false,
      "nullable": false,
      "minimum": 2
    },
    {
      "name": "tolerance",
      "kind": "float",
      "default": 1,
      "advanced": false,
      "nullable": false,
      "minimum": 0
    },
    {
      "name": "smooth",
      "kind": "float",
      "default": 0.5,
      "advanced": false,
      "nullable": false,
      "minimum": 0,
      "maximum": 1
    },
    {
      "name": "runtime",
      "kind": "string",
      "default": "{}",
      "advanced": true,
      "nullable": false
    }
  ],
  "execution": {
    "package_id": "siril",
    "operation_id": "seqsubsky",
    "inputs": {
      "image": "image"
    },
    "outputs": {
      "image": "image"
    },
    "parameters": {
      "model": {
        "kind": "parameter",
        "name": "model"
      },
      "degree": {
        "kind": "parameter",
        "name": "degree"
      },
      "no_dither": {
        "kind": "parameter",
        "name": "no_dither"
      },
      "samples": {
        "kind": "parameter",
        "name": "samples"
      },
      "tolerance": {
        "kind": "parameter",
        "name": "tolerance"
      },
      "smooth": {
        "kind": "parameter",
        "name": "smooth"
      },
      "runtime": {
        "kind": "parameter",
        "name": "runtime"
      }
    }
  }
}
