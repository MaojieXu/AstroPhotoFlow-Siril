      "default": 0,
      "advanced": false,
      "nullable": false
    },
    {
      "name": "m22",
      "kind": "float",
      "default": 1,
      "advanced": false,
      "nullable": false
    },
    {
      "name": "gamma",
      "kind": "float",
      "default": 1,
