  "definition_id": "4fe093a2-4627-5330-b28a-270df6ddbee3",
  "source": "package",
  "name": "Pixel Binning (binxy)",
  "category": [
    "geometry-channels",
    "crop-scale"
  ],
  "description": "Computes the numerical binning of the in-memory image (sum of the pixels 2x2, 3x3..., like the analogic binning of CCD camera). If the optional argument -sum is passed, then the sum of pixels is computed, while it is the average when no optional argument is provided\n\nUses fixed input references and writes only invocation-owned outputs. Optional argument values are sent only when their use_* control is true; zero is preserved.",
  "inputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "outputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "parameters": [
    {
      "name": "coefficient",
      "kind": "int",
      "default": 2,
      "advanced": false,
      "nullable": false,
      "minimum": 1
    },
    {
      "name": "sum",
      "kind": "boolean",
      "default": false,
      "advanced": false,
      "nullable": false
    },
    {
      "name": "runtime",
      "kind": "string",
      "default": "{}",
      "advanced": true,
      "nullable": false
    }
  ],
  "execution": {
    "package_id": "siril",
    "operation_id": "binxy",
    "inputs": {
      "image": "image"
    },
    "outputs": {
      "image": "image"
    },
