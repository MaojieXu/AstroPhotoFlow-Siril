  "source": "package",
  "name": "Unsharp Mask (unsharp)",
  "category": [
    "background-filters",
    "detail-enhancement"
  ],
  "description": "Applies an unsharp mask, actually a Gaussian filtered image with sigma sigma and a blend with the parameter amount used as such: out = in * (1 + amount) + filtered * (-amount).\n\nSee also GAUSS, the same without blending\n\nLinks: gauss\n\nUses fixed input references and writes only invocation-owned outputs. Optional argument values are sent only when their use_* control is true; zero is preserved.",
  "inputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "outputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "parameters": [
    {
      "name": "sigma",
      "kind": "float",
      "default": 1,
      "advanced": false,
      "nullable": false
    },
    {
      "name": "multiplier",
      "kind": "float",
      "default": 1,
      "advanced": false,
      "nullable": false
    },
    {
      "name": "runtime",
      "kind": "string",
      "default": "{}",
      "advanced": true,
      "nullable": false
    }
  ],
  "execution": {
