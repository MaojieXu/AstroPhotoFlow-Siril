  "source": "package",
  "name": "Wiener Deconvolution (wiener)",
  "category": [
    "background-filters",
    "deconvolution"
  ],
  "description": "Restores an image using the Wiener deconvolution method.\n\nOptionally, a PSF created by MAKEPSF may be loaded using the argument -loadpsf=filename .\n\nThe parameter -alpha= provides the Gaussian noise modelled regularization factor\n\nLinks: psf , makepsf\n\nUses fixed input references and writes only invocation-owned outputs. Optional argument values are sent only when their use_* control is true; zero is preserved.",
  "inputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    },
    {
      "name": "psf",
      "type": "APF_SCIENCE"
    }
  ],
  "outputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "parameters": [
    {
      "name": "use_regularisation",
      "kind": "boolean",
      "default": false,
      "advanced": true,
      "nullable": false
    },
    {
      "name": "regularisation",
      "kind": "float",
      "default": 0,
      "advanced": true,
      "nullable": false,
      "minimum": 0
    },
    {
      "name": "runtime",
      "kind": "string",
      "default": "{}",
      "advanced": true,
      "nullable": false
    }
  ],
  "execution": {
    "package_id": "siril",
    "operation_id": "wiener",
    "inputs": {
      "image": "image",
      "psf": "psf"
    },
    "outputs": {
