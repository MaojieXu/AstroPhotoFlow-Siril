      "kind": "float",
      "default": 0,
      "advanced": false,
      "nullable": false,
      "minimum": 0,
      "maximum": 1
    },
    {
      "name": "mid",
      "kind": "float",
      "default": 0.5,
      "advanced": false,
      "nullable": false,
      "minimum": 0,
      "maximum": 1
    },
    {
      "name": "high",
      "kind": "float",
      "default": 1,
      "advanced": false,
      "nullable": false,
      "minimum": 0,
      "maximum": 1
    },
