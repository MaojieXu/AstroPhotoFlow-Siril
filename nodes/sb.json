      "kind": "boolean",
      "default": false,
      "advanced": true,
      "nullable": false
    },
    {
      "name": "iterations",
      "kind": "int",
      "default": 1,
      "advanced": true,
      "nullable": false,
      "minimum": 1
    },
    {
