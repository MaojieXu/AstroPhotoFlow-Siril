  "definition_id": "5d46a8a4-89d0-5514-b5fd-005efe1bdeb9",
  "source": "package",
  "name": "Siril sb",
  "description": "Restores an image using the Split Bregman method.\n\nOptionally, a PSF may be loaded using the argument -loadpsf=filename .\n\nThe number of iterations is provide by -iters (the default is 1).\n\nThe regularization factor -alpha= provides the regularization strength (lower value = more regularization, default = 3000)\n\nLinks: psf\n\nUses fixed input references and writes only invocation-owned outputs. Optional argument values are sent only when their use_* control is true; zero is preserved.",
  "inputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    },
    {
      "name": "psf",
      "type": "APF_SCIENCE"
    }
  ],
  "outputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "parameters": [
    {
      "name": "use_regularisation",
      "kind": "boolean",
      "default": false,
      "advanced": true,
      "nullable": false
    },
    {
      "name": "regularisation",
      "kind": "float",
      "default": 0,
      "advanced": true,
      "nullable": false,
      "minimum": 0
    },
    {
