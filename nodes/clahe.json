  "source": "package",
  "name": "Contrast Limited Adaptive Histogram Equalization (clahe)",
  "category": [
    "background-filters",
    "detail-enhancement"
  ],
  "description": "Equalizes the histogram of an image using Contrast Limited Adaptive Histogram Equalization.\n\ncliplimit sets the threshold for contrast limiting.\n\ntilesize sets the size of grid for histogram equalization. Input image will be divided into equally sized rectangular tiles\n\nUses fixed input references and writes only invocation-owned outputs. Optional argument values are sent only when their use_* control is true; zero is preserved.",
  "inputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "outputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "parameters": [
    {
      "name": "cliplimit",
      "kind": "float",
      "default": 2,
      "advanced": false,
      "nullable": false
    },
    {
      "name": "tile_size",
      "kind": "int",
      "default": 8,
      "advanced": false,
      "nullable": false
    },
    {
      "name": "runtime",
      "kind": "string",
      "default": "{}",
      "advanced": true,
      "nullable": false
    }
  ],
  "execution": {
