  "source": "package",
  "name": "Siril seqcrop",
  "description": "Crops the sequence given in argument sequencename . Only selected images in the sequence are processed.\n\nThe crop selection is specified by the upper left corner position x and y and the selection width and height , like for CROP.\n\nThe output sequence name starts with the prefix \"cropped_\" unless otherwise specified with -prefix= option\n\nLinks: crop\n\nUses fixed input references and writes only invocation-owned outputs. Optional argument values are sent only when their use_* control is true; zero is preserved.",
  "inputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "outputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "parameters": [
