  "name": "Clear Sequence Auxiliary Data (seqclean)",
  "category": [
    "files-sequences",
    "sequence-management"
  ],
  "description": "This command clears selection, registration and/or statistics data stored for the sequence sequencename .\n\nYou can specify to clear only registration, statistics and/or selection with -reg , -stat and -sel options respectively. All are cleared if no option is passed\n\nUses fixed input references and writes only invocation-owned outputs. Optional argument values are sent only when their use_* control is true; zero is preserved.",
  "inputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "outputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "parameters": [
    {
      "name": "registration",
      "kind": "boolean",
      "default": false,
      "advanced": false,
      "nullable": false
    },
    {
      "name": "statistics",
      "kind": "boolean",
      "default": false,
      "advanced": false,
      "nullable": false
    },
    {
      "name": "selection",
