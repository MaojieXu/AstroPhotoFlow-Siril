{
  "definition_id": "d01ab197-f226-586c-8b7b-ff066e81b0ca",
  "source": "package",
  "name": "Export 16-bit TIFF (savetif)",
  "category": [
    "files-sequences",
    "export"
  ],
  "description": "Saves current image under the form of a uncompressed TIFF file with 16-bit per channel: filename .tif. The option -astro allows saving in Astro-TIFF format, while -deflate enables compression.\n\nSee also SAVETIF32 and SAVETIF8\n\nUses fixed input references and writes only invocation-owned outputs. Optional argument values are sent only when their use_* control is true; zero is preserved.",
  "inputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "outputs": [
    {
      "name": "file",
      "type": "APF_FILE"
    }
  ],
  "parameters": [
    {
      "name": "astro",
      "kind": "boolean",
      "default": false,
      "advanced": false,
      "nullable": false
    },
    {
      "name": "deflate",
      "kind": "boolean",
      "default": false,
      "advanced": false,
      "nullable": false
    },
    {
      "name": "runtime",
      "kind": "string",
      "default": "{}",
      "advanced": true,
      "nullable": false
    }
  ],
  "execution": {
    "package_id": "siril",
    "operation_id": "savetif",
    "inputs": {
      "image": "image"
    },
    "outputs": {
      "file": "file"
    },
    "parameters": {
      "astro": {
        "kind": "parameter",
        "name": "astro"
      },
      "deflate": {
        "kind": "parameter",
        "name": "deflate"
      },
      "runtime": {
        "kind": "parameter",
        "name": "runtime"
      }
    }
  }
}
