{
  "definition_id": "3fb50f4e-51a0-5b30-8a08-dea1dadaf0a7",
  "source": "package",
  "name": "Sequence Find Stars (seqfindstar)",
  "category": [
    "analysis",
    "star-optics"
  ],
  "description": "Same command as FINDSTAR but for the sequence sequencename .\n\nThe option -out= is not available for this process as all the star list files are saved with the default name seqname_seqnb.lst\n\nLinks: findstar\n\nUses fixed input references and writes only invocation-owned outputs. Optional argument values are sent only when their use_* control is true; zero is preserved.",
  "inputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "outputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    },
    {
      "name": "analysis",
      "type": "APF_ANALYSIS"
    },
    {
      "name": "files",
      "type": "APF_FILE"
    }
  ],
  "parameters": [
    {
      "name": "use_layer",
      "kind": "boolean",
      "default": false,
      "advanced": true,
      "nullable": false
    },
    {
      "name": "layer",
      "kind": "int",
      "default": 0,
      "advanced": true,
      "nullable": false,
      "minimum": 0,
      "maximum": 2
    },
    {
      "name": "use_maximum_stars",
      "kind": "boolean",
      "default": false,
      "advanced": true,
      "nullable": false
    },
    {
      "name": "maximum_stars",
      "kind": "int",
      "default": 0,
      "advanced": true,
      "nullable": false,
      "minimum": 0
    },
    {
      "name": "runtime",
      "kind": "string",
      "default": "{}",
      "advanced": true,
      "nullable": false
    }
  ],
  "execution": {
    "package_id": "siril",
    "operation_id": "seqfindstar",
    "inputs": {
      "image": "image"
    },
    "outputs": {
      "image": "image",
      "analysis": "analysis",
      "files": "files"
    },
    "parameters": {
      "use_layer": {
        "kind": "parameter",
        "name": "use_layer"
      },
      "layer": {
        "kind": "parameter",
        "name": "layer"
      },
      "use_maximum_stars": {
        "kind": "parameter",
        "name": "use_maximum_stars"
      },
      "maximum_stars": {
        "kind": "parameter",
        "name": "maximum_stars"
      },
      "runtime": {
        "kind": "parameter",
