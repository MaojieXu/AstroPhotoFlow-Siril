  "definition_id": "300f5e96-0258-5cac-8bfe-201f9120d55b",
  "source": "package",
  "name": "Replace Zero Pixels (nozero)",
  "category": [
    "pixel-math",
    "pixel-editing"
  ],
  "description": "Replaces null values by level values. Useful before an idiv or fdiv operation, mostly for 16-bit images\n\nUses fixed input references and writes only invocation-owned outputs. Optional argument values are sent only when their use_* control is true; zero is preserved.",
  "inputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "outputs": [
    {
      "name": "image",
      "type": "APF_SCIENCE"
    }
  ],
  "parameters": [
    {
      "name": "level",
      "kind": "float",
      "default": 1,
      "advanced": false,
      "nullable": false
    },
    {
      "name": "runtime",
      "kind": "string",
      "default": "{}",
      "advanced": true,
      "nullable": false
    }
  ],
  "execution": {
    "package_id": "siril",
    "operation_id": "nozero",
    "inputs": {
      "image": "image"
    },
    "outputs": {
      "image": "image"
    },
    "parameters": {
      "level": {
        "kind": "parameter",
        "name": "level"
      },
      "runtime": {
        "kind": "parameter",
        "name": "runtime"
      }
    }
  }
